# секреты и локальное окружение
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/

# node
node_modules/

# ос и редакторы
.DS_Store
*.swp

# рабочие и результирующие каталоги тулз, создаются при запуске

# собранная страница dashboard, если её строят прямо из корня репозитория:
# результат сборки, а не исходник
/dashboard.html
# то же самое, если её строят сидя в tools/ (dashboard page -o по умолчанию
# кладёт файл в текущий каталог) — эту точку ни один из двух .gitignore
# рядом с dashboard.html не покрывает
/tools/dashboard.html
